{
  "domain": "science",
  "display_name": "Science",
  "complexity_hints": ["single-step", "multi-step", "open-ended"],
  "tools": [
    {
      "name": "graph",
      "description": "Plot a mathematical expression over a numeric range.",
      "execution": "backend",
      "endpoint": "/tools/graph",
      "ui_component": "GraphView",
      "input_schema": {
        "expression": "string",
        "x_range": "[number, number]",
        "variables": "object?",
        "caption": "string?"
      }
    },
    {
      "name": "data_table",
      "description": "Tabular view of a dataset for inspection.",
      "execution": "backend",
      "endpoint": "/tools/data_table",
      "ui_component": "DataTable",
      "input_schema": {
        "columns": "string[]",
        "rows": "Array<Array<string|number>>"
      }
    }
  ],
  "ui_components": [
    {
      "name": "GraphView",
      "description": "Renders a plot from data or a backend-rendered image.",
      "props_schema": {
        "image_url": "string?",
        "data": "object?",
        "caption": "string?"
      },
      "trigger": "tool_result"
    },
    {
      "name": "DataTable",
      "description": "Sortable table of rows for the student to inspect.",
      "props_schema": {
        "columns": "string[]",
        "rows": "Array<Array<string|number>>"
      },
      "trigger": "tool_result"
    }
  ]
}
