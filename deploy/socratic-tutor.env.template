# Socratic Tutor — backend env.
# After bootstrap renders this to /etc/socratic-tutor.env, edit
# OPENROUTER_API_KEY to the real OpenRouter key, then chmod 600.

OPENROUTER_API_KEY=replace-me
LLM_MODEL_TUTOR=google/gemini-2.5-flash
LLM_MODEL_CLASSIFIER=qwen/qwen3.6-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PERSONA_DIR=${APP_DIR}/backend/personas
ALLOWED_ORIGINS=https://${APP_HOSTNAME}
LLM_MAX_TOKENS=2048
