# Copy this file to deploy/deploy.env on the EC2 box (it is gitignored),
# then edit values. bootstrap.sh and deploy.sh both source it.
#
# Required: the public hostname the box serves on. Used for nginx
# server_name, the TLS cert, and ALLOWED_ORIGINS.
APP_HOSTNAME=tutor.example.com

# Required: email passed to certbot for cert expiry notifications.
ADMIN_EMAIL=you@example.com

# Optional: which OS user owns the checkout and runs the service.
# If unset, bootstrap.sh uses $SUDO_USER (whoever invoked sudo), and
# deploy.sh uses $(whoami). Only set this if you need to override.
# APP_USER=

# Optional: where the repo is checked out on the box.
# Default: /opt/socratic-tutor/app.
# APP_DIR=/opt/socratic-tutor/app
