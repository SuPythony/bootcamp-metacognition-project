# Aporeka log viewer (Flask).
# Reads backend/logs/llm.jsonl and serves an interactive log UI on
# 127.0.0.1:5000. Localhost-only — access from your laptop with:
#   ssh -L 5000:127.0.0.1:5000 user@$APP_HOSTNAME
# then open http://localhost:5000 in your browser.

[Unit]
Description=Aporeka log viewer (Flask)
After=network.target

[Service]
Type=simple
User=${APP_USER}
WorkingDirectory=${APP_DIR}/backend
ExecStart=${APP_DIR}/backend/venv/bin/python scripts/view_logs.py logs/llm.jsonl --host 127.0.0.1 --port 5000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
