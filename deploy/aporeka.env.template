# Aporeka — backend env (production).
# Rendered by bootstrap.sh to /etc/aporeka.env. After rendering, set
# OPENROUTER_API_KEY to the real key. File should be chmod 600, root:root.
# Mirrors backend/.env.example with prod-appropriate values for
# PERSONA_DIR, ALLOWED_ORIGINS, and the API key placeholder.

OPENROUTER_API_KEY=replace-me

# Decent choices are:
# google/gemini-3-flash-preview
LLM_MODEL_TUTOR=google/gemini-3-flash-preview
LLM_MODEL_CLASSIFIER=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PERSONA_DIR=${APP_DIR}/backend/personas

ALLOWED_ORIGINS=https://${APP_HOSTNAME}

# LLM response length — models need ~300 tokens for reply + ~200 for control JSON
LLM_MAX_TOKENS=2048

# LLM temperature (0.0 = deterministic, 1.0 = creative)
TUTOR_TEMPERATURE=0.7
CLASSIFIER_TEMPERATURE=0.0

# Set to false to suppress LLM call logs in production once stable
LOG_LLM_CALLS=true

# Prompt variant selection — static per app run, applies to ALL sessions.
# PROMPT_VARIANT_BASE: single key for the Socratic base prompt (e.g. base:v2).
# PROMPT_VARIANT_DOMAIN: comma-separated "<domain>:<version>" pairs.
#   Each entry overrides that domain only; unlisted domains use their default (v1).
# PROMPT_VARIANT_BASE=base:v2
# PROMPT_VARIANT_DOMAIN=math:v2,essay:v1
